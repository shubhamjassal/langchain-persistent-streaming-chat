# Required: create a Google AI Studio API key and add it here.
# Never commit your real .env file or API key.
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Optional: model used by the main routing application.
# If omitted, the application uses its code-defined default.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: approximate conversation-history token budget.
HISTORY_TOKEN_BUDGET=2000

# Optional: SQLite database path. If omitted, chat_history.db
# is created in the project directory.
# CHAT_HISTORY_DB=./chat_history.db
